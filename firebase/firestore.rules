rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The portfolio never connects to Firestore directly from the browser.
    // All reads/writes go through the authenticated Node.js server using the
    // Firebase Admin SDK. Admin SDK requests bypass these rules.
    match /cms/{documentId} {
      allow read, write: if false;
    }
    match /projects/{documentId} {
      allow read, write: if false;
    }
    match /media/{documentId} {
      allow read, write: if false;
    }
    match /messages/{documentId} {
      allow read, write: if false;
    }
    match /auditLogs/{documentId} {
      allow read, write: if false;
    }
    match /admins/{documentId} {
      allow read, write: if false;
    }
    match /sessions/{documentId} {
      allow read, write: if false;
    }
    // Default deny for any future collection accidentally added to Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
